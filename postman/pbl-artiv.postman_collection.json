  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Coba ambil dari meta tag dulu (lebih universal)\r",
          "pm.sendRequest({\r",
          "    url: pm.environment.get(\"base_url\") + \"/customer/beranda\", \r",
          "    method: 'GET'\r",
          "}, function (err, res) {\r",
          "    if (!err) {\r",
          "        let html = res.text();\r",
          "        let match = html.match(/<meta name=\"csrf-token\" content=\"([^\"]+)\"/);\r",
          "        if (match && match[1]) {\r",
          "            pm.environment.set(\"csrf_token\", match[1]);\r",
          "            console.log(\"✅ Token dari meta:\", match[1].substring(0, 10));\r",
          "            return;\r",
          "        }\r",
          "        // Fallback: cari di form input\r",
          "        let match2 = html.match(/name=\"_token\" value=\"([^\"]+)\"/);\r",
          "        if (match2 && match2[1]) {\r",
          "            pm.environment.set(\"csrf_token\", match2[1]);\r",
          "            console.log(\"✅ Token dari form:\", match2[1].substring(0, 10));\r",
          "        }\r",
          "    }\r",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "X-XSRF-TOKEN",
      "value": ""
    }
  ]
