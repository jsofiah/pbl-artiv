    {
      "name": "logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              ""
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Tembak halaman beranda (atau halaman apa saja yang bisa diakses)\r\npm.sendRequest({\r\n    url: pm.environment.get(\"base_url\") + \"/customer/beranda\", \r\n    method: 'GET'\r\n}, function (err, res) {\r\n    if (err) {\r\n        console.log(\"Gagal ambil halaman:\", err);\r\n    } else {\r\n        // 2. Cari token di dalam tag <meta name=\"csrf-token\" content=\"...\">\r\n        let html = res.text();\r\n        let match = html.match(/<meta name=\"csrf-token\" content=\"([^\"]+)\"/);\r\n        \r\n        if (match && match[1]) {\r\n            // 3. Simpan token ke environment\r\n            pm.environment.set(\"csrf_token\", match[1]);\r\n            console.log(\"✅ Token Meta berhasil didapat: \" + match[1].substring(0, 10) + \"...\");\r\n        } else {\r\n            console.log(\"❌ Token meta tidak ditemukan. Cek response HTML.\");\r\n        }\r\n    }\r\n});"
            ]
          }
        }
      ],
